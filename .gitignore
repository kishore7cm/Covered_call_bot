.env
.env.*
!.env.example
__pycache__/
*.pyc
*.log
logs/
.DS_Store
# pipeline_state/* (not pipeline_state/) so the negation below can still
# match a specific file inside it -- git won't apply per-file negations to
# anything inside a directory excluded via a trailing-slash pattern.
pipeline_state/*
# intents.json is a human-curated decision file (symbol -> "hold"/"exit"),
# not a regenerable pipeline artifact like everything else in this
# directory -- tracked deliberately, same spirit as config.WATCHLIST.
!pipeline_state/intents.json
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*credentials*
*secret*
.pytest_cache/
